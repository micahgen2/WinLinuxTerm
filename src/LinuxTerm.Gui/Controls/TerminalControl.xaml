<UserControl x:Class="LinuxTerm.Gui.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Focusable="True"
             Loaded="UserControl_Loaded">
    <Grid x:Name="RootGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Terminal Output Buffer -->
        <RichTextBox x:Name="OutputBox"
                     Grid.Row="0"
                     Background="Transparent"
                     Foreground="#CCCCCC"
                     BorderThickness="0"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="13.5"
                     IsReadOnly="True"
                     IsUndoEnabled="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12,10,12,6"
                     PreviewKeyDown="OutputBox_PreviewKeyDown"
                     MouseLeftButtonDown="OutputBox_MouseLeftButtonDown">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="LineHeight" Value="1.3" />
                </Style>
            </RichTextBox.Resources>
            <FlowDocument x:Name="TerminalDoc" PagePadding="0" />
        </RichTextBox>

        <!-- Autocomplete Suggestions Popup/Box -->
        <Border x:Name="SuggestionsBorder"
                Grid.Row="1"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="4"
                Margin="12,0,12,4"
                Padding="6"
                Visibility="Collapsed">
            <WrapPanel x:Name="SuggestionsPanel" />
        </Border>

        <!-- Command Input Line -->
        <Border Grid.Row="2" 
                x:Name="InputContainer"
                Background="#252526"
                BorderBrush="#333337"
                BorderThickness="0,1,0,0"
                Padding="12,6,12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Linux Prompt Display -->
                <TextBlock x:Name="PromptBlock"
                           Grid.Column="0"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Input Text Box -->
                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="#FFFFFF"
                         CaretBrush="#00FF66"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13.5"
                         VerticalAlignment="Center"
                         PreviewKeyDown="CommandInput_PreviewKeyDown"
                         TextChanged="CommandInput_TextChanged" />

                <!-- Running Indicator -->
                <StackPanel Grid.Column="2" 
                            x:Name="RunningIndicator" 
                            Orientation="Horizontal" 
                            Visibility="Collapsed" 
                            VerticalAlignment="Center">
                    <TextBlock Text="[Running... Ctrl+C to cancel]" 
                               Foreground="#FFCC00" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="12" 
                               FontStyle="Italic" 
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                x:Name="StatusBarBorder"
                Background="#181818"
                BorderBrush="#2D2D30"
                BorderThickness="0,1,0,0"
                Padding="10,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDirectory" 
                               Text="~" 
                               Foreground="#569CD6" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock x:Name="StatusGit" 
                               Text="" 
                               Foreground="#DCDCAA" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" 
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusExitCode" 
                               Text="exit: 0" 
                               Foreground="#4EC9B0" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock Text="/bin/bash" 
                               Foreground="#858585" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock Text="UTF-8" 
                               Foreground="#858585" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
