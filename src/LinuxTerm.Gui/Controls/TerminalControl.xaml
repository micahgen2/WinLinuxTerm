<UserControl x:Class="LinuxTerm.Gui.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Focusable="True"
             Loaded="UserControl_Loaded">
    <Grid x:Name="RootGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Terminal Output Buffer & Search Bar Overlay -->
        <Grid Grid.Row="0">
            <RichTextBox x:Name="OutputBox"
                         Background="Transparent"
                         Foreground="#CCCCCC"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13.5"
                         IsReadOnly="True"
                         IsUndoEnabled="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="12,10,12,6"
                         PreviewKeyDown="OutputBox_PreviewKeyDown"
                         MouseLeftButtonDown="OutputBox_MouseLeftButtonDown">
                <RichTextBox.ContextMenu>
                    <ContextMenu Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42">
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="MenuPaste_Click" />
                        <Separator Background="#3E3E42" />
                        <MenuItem Header="Find..." InputGestureText="Ctrl+F" Click="MenuFind_Click" />
                        <MenuItem Header="Clear Screen" InputGestureText="Ctrl+L" Click="MenuClear_Click" />
                        <Separator Background="#3E3E42" />
                        <MenuItem Header="Split Vertically" InputGestureText="Ctrl+Shift+E" Click="MenuSplitVertical_Click" />
                        <MenuItem Header="Split Horizontally" InputGestureText="Ctrl+Shift+O" Click="MenuSplitHorizontal_Click" />
                        <Separator Background="#3E3E42" />
                        <MenuItem Header="Open Folder in Explorer" Click="MenuOpenExplorer_Click" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="LineHeight" Value="1.3" />
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument x:Name="TerminalDoc" PagePadding="0" />
            </RichTextBox>

            <!-- Floating Search Bar Overlay (Ctrl+F) -->
            <Border x:Name="SearchBar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,16,0"
                    Background="#2D2D30"
                    BorderBrush="#007ACC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,4,6,4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchInput"
                             Width="160"
                             Height="22"
                             Background="#1E1E1E"
                             Foreground="#FFFFFF"
                             BorderBrush="#3E3E42"
                             BorderThickness="1"
                             FontFamily="Cascadia Code, Consolas"
                             FontSize="12"
                             VerticalAlignment="Center"
                             TextChanged="SearchInput_TextChanged"
                             KeyDown="SearchInput_KeyDown" />
                    
                    <TextBlock x:Name="SearchCountBlock"
                               Text="No matches"
                               Foreground="#888888"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />

                    <Button Content="▲" Width="22" Height="22" FontSize="10"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,3,0" Cursor="Hand" ToolTip="Previous Match (Shift+Enter)"
                            Click="BtnFindPrev_Click" />
                    <Button Content="▼" Width="22" Height="22" FontSize="10"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,6,0" Cursor="Hand" ToolTip="Next Match (Enter)"
                            Click="BtnFindNext_Click" />
                    <Button Content="✕" Width="20" Height="22" FontSize="10"
                            Background="Transparent" Foreground="#888888" BorderThickness="0"
                            Cursor="Hand" ToolTip="Close (Esc)"
                            Click="BtnCloseSearch_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Autocomplete Suggestions Popup/Box -->
        <Border x:Name="SuggestionsBorder"
                Grid.Row="1"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="4"
                Margin="12,0,12,4"
                Padding="6"
                Visibility="Collapsed">
            <WrapPanel x:Name="SuggestionsPanel" />
        </Border>

        <!-- Command Input Line -->
        <Border Grid.Row="2" 
                x:Name="InputContainer"
                Background="#252526"
                BorderBrush="#333337"
                BorderThickness="0,1,0,0"
                Padding="12,6,12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Linux Prompt Display -->
                <TextBlock x:Name="PromptBlock"
                           Grid.Column="0"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Input Text Box -->
                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="#FFFFFF"
                         CaretBrush="#00FF66"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13.5"
                         VerticalAlignment="Center"
                         PreviewKeyDown="CommandInput_PreviewKeyDown"
                         TextChanged="CommandInput_TextChanged">
                    <TextBox.ContextMenu>
                        <ContextMenu Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42">
                            <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="MenuPaste_Click" />
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
                            <MenuItem Header="Clear Screen" InputGestureText="Ctrl+L" Click="MenuClear_Click" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <!-- Running Indicator -->
                <StackPanel Grid.Column="2" 
                            x:Name="RunningIndicator" 
                            Orientation="Horizontal" 
                            Visibility="Collapsed" 
                            VerticalAlignment="Center">
                    <TextBlock Text="[Running... Ctrl+C to cancel]" 
                               Foreground="#FFCC00" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="12" 
                               FontStyle="Italic" 
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                x:Name="StatusBarBorder"
                Background="#181818"
                BorderBrush="#2D2D30"
                BorderThickness="0,1,0,0"
                Padding="10,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDirectory" 
                               Text="~" 
                               Foreground="#569CD6" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock x:Name="StatusGit" 
                               Text="" 
                               Foreground="#DCDCAA" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" 
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusExitCode" 
                               Text="exit: 0" 
                               Foreground="#4EC9B0" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock Text="/bin/bash" 
                               Foreground="#858585" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" 
                               Margin="0,0,14,0" />
                    <TextBlock Text="UTF-8" 
                               Foreground="#858585" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full-Screen Interactive Editor Overlay (Nano & Vim) -->
        <Grid x:Name="EditorOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="#1E1E1E"
              Visibility="Collapsed"
              Focusable="True"
              PreviewKeyDown="EditorOverlay_PreviewKeyDown"
              PreviewTextInput="EditorOverlay_PreviewTextInput"
              MouseDown="EditorOverlay_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header Bar -->
                <RowDefinition Height="*" />    <!-- Main Text Area -->
                <RowDefinition Height="Auto" /> <!-- Status / Prompt Bar -->
                <RowDefinition Height="Auto" /> <!-- Nano Shortcut Bar -->
            </Grid.RowDefinitions>

            <!-- Editor Header Bar (Nano Title / Modified) -->
            <Border x:Name="EditorHeader"
                    Grid.Row="0"
                    Background="#007ACC"
                    Padding="10,4,10,4">
                <Grid>
                    <TextBlock x:Name="EditorHeaderTitle"
                               Text="GNU nano 8.0"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="EditorHeaderFile"
                               Text="File: untitled.txt"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EditorHeaderModified"
                               Text="Modified"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFD700"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- Main Text Canvas -->
            <Grid Grid.Row="1" x:Name="EditorContentGrid" Margin="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Line Numbers -->
                    <ColumnDefinition Width="*" />    <!-- Buffer Lines -->
                </Grid.ColumnDefinitions>

                <!-- Line Numbers Column (Vim) -->
                <Border Grid.Column="0"
                        x:Name="EditorLineNumbersBorder"
                        Background="#181818"
                        BorderBrush="#2D2D30"
                        BorderThickness="0,0,1,0"
                        Padding="8,4,8,4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="EditorLineNumbers"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="13.5"
                               Foreground="#5A5A5A"
                               TextAlignment="Right"
                               LineHeight="1.3" />
                </Border>

                <!-- Scrollable Buffer Text Canvas -->
                <ScrollViewer Grid.Column="1"
                              x:Name="EditorScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="8,4,8,4">
                    <RichTextBox x:Name="EditorRichTextBox"
                                 Background="Transparent"
                                 Foreground="#CCCCCC"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="13.5"
                                 IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 Focusable="False">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="LineHeight" Value="1.3" />
                            </Style>
                        </RichTextBox.Resources>
                        <FlowDocument x:Name="EditorDoc" PagePadding="0" />
                    </RichTextBox>
                </ScrollViewer>
            </Grid>

            <!-- Status / Message / Prompt Bar -->
            <Border x:Name="EditorStatusBar"
                    Grid.Row="2"
                    Background="#252526"
                    BorderBrush="#333337"
                    BorderThickness="0,1,0,0"
                    Padding="10,4,10,4">
                <Grid>
                    <TextBlock x:Name="EditorStatusText"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="EditorPositionText"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               Foreground="#858585"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- Nano 2-Line Shortcut Helper Panel -->
            <Border x:Name="EditorShortcutBar"
                    Grid.Row="3"
                    Background="#181818"
                    BorderBrush="#2D2D30"
                    BorderThickness="0,1,0,0"
                    Padding="10,4,10,4">
                <StackPanel>
                    <TextBlock Text="^G Help     ^O WriteOut     ^W Where Is     ^K Cut Text"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="11.5"
                               Foreground="#DCDCAA" />
                    <TextBlock Text="^X Exit     ^R Read File    ^\ Replace      ^U Paste Text"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="11.5"
                               Foreground="#DCDCAA" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
