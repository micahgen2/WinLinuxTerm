<Window x:Class="LinuxTerm.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinLinuxTerm" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar / Tab Bar -->
            <RowDefinition Height="38" />
            <!-- Active Terminal Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Window Header & Tab Strip -->
        <Border Grid.Row="0" 
                x:Name="TitleBarBorder"
                Background="#1E1E1E" 
                BorderBrush="#2D2D30" 
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- App Logo / Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Tabs & New Tab Button -->
                    <ColumnDefinition Width="*" />
                    <!-- Theme Selector & Zoom -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0">
                    <TextBlock Text=">_" 
                               Foreground="#00FF66" 
                               FontFamily="Cascadia Code, Consolas" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               Margin="0,0,6,0" />
                    <TextBlock Text="WinLinuxTerm" 
                               Foreground="#FFFFFF" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tab Headers and Add Button -->
                <ScrollViewer Grid.Column="1" 
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <StackPanel x:Name="TabHeaderPanel" Orientation="Horizontal" />
                        
                        <!-- New Tab Button -->
                        <Button x:Name="BtnNewTab"
                                Content="+"
                                ToolTip="New Tab (Ctrl+T)"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                BorderThickness="0"
                                Width="28" Height="28"
                                FontSize="18"
                                Cursor="Hand"
                                Margin="4,5,0,5"
                                Click="BtnNewTab_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Theme, Split & Zoom Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Split Controls -->
                    <Button Content="◫" Width="26" Height="22" FontSize="13"
                            Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,3,0" Cursor="Hand" ToolTip="Split Vertically (Ctrl+Shift+E)"
                            Click="BtnSplitVertical_Click" />
                    <Button Content="⬒" Width="26" Height="22" FontSize="13"
                            Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,8,0" Cursor="Hand" ToolTip="Split Horizontally (Ctrl+Shift+O)"
                            Click="BtnSplitHorizontal_Click" />

                    <!-- Search Button -->
                    <Button Content="🔍" Width="24" Height="22" FontSize="11"
                            Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,8,0" Cursor="Hand" ToolTip="Find in Terminal (Ctrl+F)"
                            Click="BtnFind_Click" />

                    <!-- Zoom Controls -->
                    <Button Content="-" Width="22" Height="22" FontSize="14" FontWeight="Bold"
                            Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,3,0" Cursor="Hand" ToolTip="Zoom Out (Ctrl+-)"
                            Click="BtnZoomOut_Click" />
                    <Button Content="+" Width="22" Height="22" FontSize="14" FontWeight="Bold"
                            Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0"
                            Margin="0,0,10,0" Cursor="Hand" ToolTip="Zoom In (Ctrl++)"
                            Click="BtnZoomIn_Click" />

                    <!-- Theme Selector -->
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Foreground="#888888" FontSize="11" Margin="0,0,5,0" />
                    <ComboBox x:Name="ThemeSelector"
                              Width="140" Height="24"
                              Background="#2D2D30"
                              Foreground="#FFFFFF"
                              BorderThickness="1"
                              BorderBrush="#3E3E42"
                              FontSize="11.5"
                              SelectionChanged="ThemeSelector_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Terminal Tab Container -->
        <Grid Grid.Row="1" x:Name="TerminalContainer" />
    </Grid>
</Window>
